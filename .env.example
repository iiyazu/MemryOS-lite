# --- MemoryOS core (maps to pydantic Settings fields) ---
DATA_DIR=.memoryos
MODEL_MAX_CONTEXT=128000
ROT_SAFE_BUDGET=2400
HARD_LIMIT=8000
RECENT_MESSAGE_LIMIT=8
MEMORYOS_EVIDENCE_RESERVE_RATIO=0.6
MEMORYOS_EVIDENCE_RESERVE_TOKENS=64
MEMORYOS_EVIDENCE_RESERVE_MIN_PAGES=8
MEMORYOS_PAGING_MODE=heuristic

# --- OpenAI / compatible APIs (optional; leave blank for offline defaults) ---
# Deterministic commands such as `memoryos demo curate`, `--fake-llm` evaluation runs,
# and public evals with `--no-llm-answer --no-llm-judge` do not require these.
# Real API calls may occur when keys are set and you opt into LLM paging,
# LLM judge/answer flags, or agent graphs without a fake LLM.
MEMORYOS_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
MEMORYOS_MODEL=gpt-4o-mini
MEMORYOS_EMBEDDING_MODEL=text-embedding-3-small

# --- DeepSeek chat LLM (optional; OpenAI-compatible chat endpoint) ---
# DeepSeek is used only for chat-compatible features.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- OpenCode Go (optional; MEMORYOS_LLM_PROVIDER=opencode) ---
# Curator and RoomMem roles only. Muse Spark models use the Responses API;
# set OPENCODE_WIRE_API=chat for chat-completions models (e.g. kimi-k3).
# "contributor" models allow Meta to train on prompts and completions.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=muse-spark-1.3-contributor
OPENCODE_WIRE_API=responses

# --- API auth ---
API_KEY=dev-local-key
